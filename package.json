{
  "name": "t-bot",
  "version": "0.0.1",
  "main": "index.js",
  "scripts": {
    "bot": "ts-node src/bots/tg/simple-index.ts",
    "bot-dev": "nodemon --watch 'src/bots/tg/**/*.ts' --exec 'ts-node' src/bots/tg/simple-index.ts",
    "migrate": "ts-node src/bots/tg/database/migrations/migrate.ts",
    "db:start": "sudo systemctl start postgresql@14-main",
    "db:stop": "sudo systemctl stop postgresql@14-main",
    "db:restart": "sudo systemctl restart postgresql@14-main",
    "db:status": "sudo systemctl status postgresql@14-main",
    "db:connect": "psql -h localhost -p 5433 -U freeb -d t_db",
    "db:shell": "sudo -u postgres psql",
    "db:backup": "pg_dump -h localhost -p 5433 -U freeb -d t_db > backup_$(date +%Y%m%d_%H%M%S).sql",
    "db:restore": "psql -h localhost -p 5433 -U freeb -d t_db <",
    "db:logs": "sudo tail -f /var/log/postgresql/postgresql-14-main.log",
    "server-express": "ts-node src/server/index.ts",
    "server-express-dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/server/express/index.ts",
    "server-fastify-dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/server/fastify/index.ts",
    "rag-check": "ts-node -r tsconfig-paths/register src/catalog-rags/um/rag/check.ts",
    "lint": "eslint 'src/**/*.ts'"
  },
  "keywords": [],
  "author": "freebit",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/env": "^5.0.3",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.5",
    "@types/pg": "^8.16.0",
    "@types/redis": "^4.0.10",
    "@types/uuid": "^10.0.0",
    "@types/winston": "^2.4.4",
    "@xenova/transformers": "^2.17.2",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.3.4",
    "fastify": "^5.7.2",
    "ioredis": "^5.9.3",
    "joi": "^18.0.2",
    "json-schema-to-ts": "^3.1.1",
    "pg": "^8.18.0",
    "redis": "^5.10.0",
    "telegraf": "^4.16.3",
    "uuid": "^13.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.6",
    "eslint": "^9.39.2",
    "eslint-plugin-prettier": "^5.5.5",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
