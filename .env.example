# Telegram Bot Configuration
TG_BOT_TOKEN=your_telegram_bot_token_here

# PostgreSQL Configuration
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=t_db
PG_USERNAME=freeb
PG_PASSWORD=freeb
PG_SSL=false
PG_MAX_CONNECTIONS=20

# Redis Configuration (опционально)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=false

# Delivery Services API Keys (опционально)
SDEK_TOKEN=your_sdek_token
RUSSIAN_POST_TOKEN=your_russian_post_token
BUSINESS_LINES_TOKEN=your_business_lines_token
PEK_TOKEN=your_pek_token
BAIKAL_TOKEN=your_baikal_token

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Cache Configuration
CACHE_DELIVERY_TTL=1800
CACHE_SESSION_TTL=3600

# Security Configuration
MAX_REQUESTS_PER_MINUTE=30
MAX_FILE_SIZE=20971520
ALLOWED_USERS=
ADMIN_USERS=your_telegram_id_here
